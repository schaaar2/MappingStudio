###  http://purl.obolibrary.org/obo/NCIT_C15206
<http://purl.obolibrary.org/obo/NCIT_C15206> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/NCIT_C63536> ,
                                                             _:genid11 ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "Research conducted with human subjects or on material of human origin in which an investigator directly interacts with human subjects; includes development of new technologies, study of mechanisms of human diseases, therapy, clinical trials, epidemiologic, behavior, and health services research." ;
                                             <http://purl.obolibrary.org/obo/NCIT_NHC0> "C15206" ;
                                             <http://purl.obolibrary.org/obo/NCIT_P106> "Research Activity" ;
                                             <http://purl.obolibrary.org/obo/NCIT_P108> "Clinical Study" ;
                                             <http://purl.obolibrary.org/obo/NCIT_P207> "C0008972" ;
                                             <http://purl.obolibrary.org/obo/NCIT_P322> "CDISC" ,
                                                                                        "CDISC-GLOSS" ,
                                                                                        "FDA" ,
                                                                                        "ICDC" ,
                                                                                        "SeroNet" ;
